APP_NAME="SNSC-MALI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vaccin_track
DB_USERNAME=vaccin_user
DB_PASSWORD=replace-by-compose-environment

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

JWT_ALGO=RS256
JWT_PUBLIC_KEY=file://./storage/jwt/public.pem
JWT_PRIVATE_KEY=file://./storage/jwt/private.pem
JWT_PASSPHRASE=
JWT_TTL=15
JWT_BLACKLIST_ENABLED=true
